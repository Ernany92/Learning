"""
Sistema de Avaliação de Aluno
Autor: Ernany Verruck

Programa em Python que utiliza menu interativo e funções
para cadastrar um aluno, calcular a média de notas
e informar se o aluno foi aprovado ou reprovado.

Projeto desenvolvido para fins de estudo e prática
de lógica de programação e organização de código.
"""

def mostrar_menu():

    print("\n=== MENU DO ALUNO ===")
    print("1 - Cadastrar aluno")
    print("2 - Calcular média e situação")
    print("3 - Mostrar resultado")
    print("0 - Sair")

def cadastrar_aluno():
    nome = input("Digite o nome do aluno: ")
    nota1 = float(input("Digite a nota 1: "))
    nota2 = float(input("Digite a nota 2: "))
    return nome, nota1, nota2

def calcular_media_e_situacao(nota1, nota2):
    media = (nota1 + nota2) / 2

    if media >= 7:
        situacao = "Aprovado"
    else:
        situacao = "Reprovado"

    return media, situacao

def mostrar_resultado(nome, nota1, nota2, media, situacao):
    print("\n=== RESULTADO FINAL ===")
    print("Aluno:", nome)
    print("Nota 1:", nota1)
    print("Nota 2:", nota2)
    print("Média:", media)
    print("Situação:", situacao)


 # Variáveis iniciais
nome = ""
nota1 = 0
nota2 = 0
media = 0
situacao = ""

while True:
    mostrar_menu()
    opcao = input("Escolha uma opção: ")

    if opcao == "1":
        nome, nota1, nota2 = cadastrar_aluno()

    elif opcao == "2":
        media, situacao = calcular_media_e_situacao(nota1, nota2)
        print("Média e situação calculadas!")

    elif opcao == "3":
        mostrar_resultado(nome, nota1, nota2, media, situacao)

    elif opcao == "0":
        print("Saindo do programa...")
        break

    else:
        print("Opção inválida! Tente novamente.")
